{
  "source": "global.css",
  "description": "字体规范，从 global.css :root 中 --harmony-font-size-* / --harmony-font-weight-* 提取。字体家族来自 html 与 --button-harmony-font-family。行高按设计比率推算（display 1.2×, title 1.33×, subtitle 1.44×, body 1.5×, caption 1.67×）。",
  "rules": {
    "allowedFontFamilies": [
      "HarmonyHeiTi",
      "Geist Variable"
    ],
    "allowedFontSizes": [
      8,
      10,
      12,
      14,
      16,
      18,
      20,
      24,
      30,
      38,
      48,
      56
    ],
    "allowedFontWeights": [
      300,
      400,
      500,
      700
    ],
    "allowedLineHeights": [
      13,
      17,
      18,
      20,
      21,
      23,
      24,
      26,
      27,
      32,
      40,
      46,
      58,
      67
    ],
    "constraintsCN": [
      "字体家族必须在 allowedFontFamilies 内",
      "字号必须在 allowedFontSizes 内",
      "字重必须在 allowedFontWeights 内",
      "行高必须在 allowedLineHeights 内"
    ]
  },
  "fonts": [
